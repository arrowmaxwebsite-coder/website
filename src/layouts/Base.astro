---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { SITE, COUNTIES } from '../config';

interface Props {
  title: string;
  description: string;
  /** set false for thin pages we don't want indexed */
  index?: boolean;
  ogImage?: string;
  /** breadcrumb trail after "Home" (last item = this page) → emitted as BreadcrumbList JSON-LD */
  crumbs?: { label: string; href?: string }[];
  /** any extra schema.org objects (Service, FAQPage, …) */
  schema?: object[];
}
const { title, description, index = true, ogImage = '/og-image.jpg', crumbs, schema: extraSchema = [] } = Astro.props;

const breadcrumbSchema = crumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ label: 'Home', href: '/' }, ...crumbs].map((c, i, arr) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        item: new URL(i === arr.length - 1 ? Astro.url.pathname : (c.href ?? '/'), SITE.url).toString(),
      })),
    }
  : null;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogUrl = new URL(ogImage, SITE.url).toString();

const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  alternateName: 'ArrowMax',
  description,
  url: SITE.url,
  telephone: SITE.phoneE164,
  email: SITE.email,
  image: new URL('/og-image.jpg', SITE.url).toString(),
  logo: new URL('/icon-512.png', SITE.url).toString(),
  priceRange: 'Free quotes',
  areaServed: COUNTIES.map((c) => ({ '@type': 'AdministrativeArea', name: `${c.name}, Pennsylvania` })),
  address: { '@type': 'PostalAddress', addressRegion: 'PA', addressCountry: 'US' },
  makesOffer: ['Carpet cleaning', 'Tile and grout cleaning', 'Hardwood floor cleaning', 'Upholstery cleaning', 'Pet urine treatment', 'Rug cleaning'].map(
    (n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })
  ),
  ...(SITE.social.length ? { sameAs: SITE.social.map((s) => s.href) } : {}),
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!index && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#002244" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
      // Safety net: if the main script never runs, un-hide anything waiting on the scroll-reveal.
      setTimeout(function () { if (!window.__ready) document.documentElement.classList.remove('js'); }, 4000);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {extraSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ChatWidget />

    <script>
      // Scroll-reveal: fades sections in as they enter the viewport.
      (window as unknown as { __ready: boolean }).__ready = true;
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
