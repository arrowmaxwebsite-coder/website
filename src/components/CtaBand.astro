---
import { Image } from 'astro:assets';
import mop from '../assets/photos/cta-mop.jpg';
import Icon from './Icon.astro';
import { SITE } from '../config';

interface Props { title?: string; text?: string }
const { title = 'Ready for floors that look their best?', text = 'Get a straight answer on price. No pressure attached.' } = Astro.props;
---

<section class="cta section--tight">
  <div class="container">
    <div class="cta__card on-dark" data-reveal>
      <div class="cta__img" aria-hidden="true"><Image src={mop} alt="" widths={[640, 1000]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" /></div>
      <div class="cta__copy">
        <p class="eyebrow">Free quote</p>
        <h2>{title}</h2>
        <p class="lead">{text}</p>
        <div class="cta__actions">
          <a class="btn btn--primary btn--lg" href="/contact">Get your free quote <Icon name="arrow" class="i-arrow" /></a>
          <a class="cta__phone" href={SITE.phoneHref}><span>or call</span><strong>{SITE.phone}</strong></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--white); }
  .cta__card {
    position: relative; overflow: hidden; border-radius: var(--r-lg); color: #fff; isolation: isolate;
    background: linear-gradient(120deg, var(--navy-900) 0%, var(--navy-800) 60%, #0b5a8f 100%);
    box-shadow: var(--shadow-2); padding: clamp(2rem, 5vw, 4.5rem);
    min-height: 22rem; display: flex; align-items: center;
  }
  .cta__img { position: absolute; inset: 0 0 0 38%; z-index: -1; opacity: .95;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 55%); mask-image: linear-gradient(90deg, transparent 0, #000 55%); }
  .cta__img :global(img) { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: lighten; }
  .cta__card::before {
    content: ''; position: absolute; z-index: -1; left: -10%; bottom: -55%; width: 70%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(168, 223, 24, .35), transparent); filter: blur(10px);
  }
  .cta__copy { display: grid; gap: 1.1rem; max-width: 34rem; }
  .cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem 1.8rem; margin-top: .6rem; }
  .cta__phone { display: grid; line-height: 1.2; text-decoration: none; color: #fff; }
  .cta__phone span { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--aqua-300); }
  .cta__phone strong { font-family: var(--font-display); font-size: 1.5rem; letter-spacing: -0.01em; }
  .cta__phone:hover strong { color: var(--lime-500); }
  @media (max-width: 760px) {
    .cta__img { inset: 0; opacity: .35; -webkit-mask-image: none; mask-image: none; }
    .cta__card { min-height: 0; }
  }
</style>
