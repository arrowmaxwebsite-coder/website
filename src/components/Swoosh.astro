---
// The logo's sweeping arrow-swoosh, redrawn as scalable SVG. Used as a signature background motif.
interface Props { id?: string; class?: string; animate?: boolean }
const { id = 'sw', class: cls = '', animate = true } = Astro.props;
---

<svg class:list={['swoosh', animate && 'swoosh--anim', cls]} viewBox="0 0 1440 600" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-a`} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#6CB01E" />
      <stop offset=".42" stop-color="#D3F516" />
      <stop offset="1" stop-color="#4EC7EE" />
    </linearGradient>
    <linearGradient id={`${id}-b`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#4EC7EE" stop-opacity="0" />
      <stop offset=".35" stop-color="#4EC7EE" />
      <stop offset="1" stop-color="#ADF2EE" />
    </linearGradient>
  </defs>
  <!-- main crescent, tapering to an arrow tip at the right -->
  <path d="M-20 500 C 380 522, 960 470, 1450 90 C 1010 590, 420 640, -20 520 Z" fill={`url(#${id}-a)`} />
  <!-- aqua companion stroke -->
  <path d="M-20 548 C 420 600, 1000 560, 1450 150 C 1040 610, 460 650, -20 556 Z" fill={`url(#${id}-b)`} opacity=".85" />
  <!-- hairline -->
  <path d="M120 590 C 520 628, 1080 590, 1450 190" fill="none" stroke="#ADF2EE" stroke-opacity=".5" stroke-width="2" />
</svg>

<style>
  .swoosh { width: 100%; height: 100%; display: block; }
  .swoosh--anim { animation: swoosh-in 1.6s var(--ease) .15s both; }
  @keyframes swoosh-in {
    from { clip-path: inset(0 100% 0 0); opacity: .2; }
    to { clip-path: inset(0 0 0 0); opacity: 1; }
  }
</style>
