---
import Icon from './Icon.astro';
import { SITE } from '../config';

/**
 * Floating "Ask ArrowMax" chat assistant. Talks to POST /api/chat (worker/chat.ts, Cloudflare Workers AI).
 * Hidden until its script runs, so visitors without JavaScript never see a button that does nothing.
 * The quote form stays the main call to action: the panel always shows a "Get a free estimate" link.
 */
---

<div class="cw" data-chat data-endpoint="/api/chat" data-phone={SITE.phone} data-phone-href={SITE.phoneHref}>
  <button class="cw__launcher" type="button" data-chat-open aria-expanded="false" aria-controls="chat-panel" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></svg>
    <span class="cw__launcher-long">Ask ArrowMax</span>
    <span class="cw__launcher-short">Ask us</span>
  </button>

  <section class="cw__panel" id="chat-panel" data-chat-panel role="dialog" aria-labelledby="chat-title" hidden>
    <header class="cw__head">
      <span class="cw__avatar" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></svg>
      </span>
      <div class="cw__title">
        <h2 id="chat-title">ArrowMax assistant</h2>
        <p>AI assistant · answers in seconds</p>
      </div>
      <button class="cw__icon-btn" type="button" data-chat-reset aria-label="Start a new chat" title="New chat">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
      </button>
      <button class="cw__icon-btn" type="button" data-chat-close aria-label="Close chat" title="Close">
        <Icon name="x" />
      </button>
    </header>

    <div class="cw__log" data-chat-log role="log" aria-live="polite" aria-label="Conversation" tabindex="0"></div>

    <div class="cw__chips" data-chat-chips>
      <button type="button" data-chat-suggest="What services do you offer?">What services do you offer?</button>
      <button type="button" data-chat-suggest="Do you serve my area?">Do you serve my area?</button>
      <button type="button" data-chat-suggest="How do free estimates work?">How do free estimates work?</button>
      <button type="button" data-chat-suggest="Can you remove pet stains and odors?">Pet stains &amp; odors?</button>
    </div>

    <form class="cw__form" data-chat-form>
      <label class="sr-only" for="chat-input">Your question</label>
      <textarea id="chat-input" data-chat-input rows="1" maxlength="500" placeholder="Type your question…" enterkeyhint="send" autocomplete="off"></textarea>
      <button class="cw__send" type="submit" data-chat-send aria-label="Send message">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
      </button>
    </form>

    <footer class="cw__foot">
      <div class="cw__actions">
        <a class="cw__cta" href="/contact">Get a free estimate <Icon name="arrow" /></a>
        <a class="cw__call" href={SITE.phoneHref}><Icon name="phone" /> {SITE.phone}</a>
      </div>
      <p>AI assistant: it can’t quote prices or book jobs, so please use the estimate form. Please don’t share personal details in chat.</p>
    </footer>
  </section>
</div>

<style is:global>
  .cw [hidden] { display: none !important; }

  /* ---------- launcher ---------- */
  .cw__launcher {
    position: fixed; z-index: 95; right: 1.1rem; bottom: 1.1rem;
    display: inline-flex; align-items: center; gap: .6rem; cursor: pointer;
    padding: .8rem 1.2rem .8rem 1rem; border-radius: 999px;
    background: var(--navy-900); color: #fff; border: 1px solid rgba(168, 223, 24, .45);
    font: 650 .98rem/1 var(--font-body);
    box-shadow: 0 16px 34px -12px rgba(0, 23, 48, .65);
    transition: transform .25s var(--ease), box-shadow .25s, background .2s;
  }
  .cw__launcher:hover { transform: translateY(-3px); background: var(--navy-800); box-shadow: 0 22px 40px -12px rgba(0, 23, 48, .7); }
  .cw__launcher:focus-visible, .cw__icon-btn:focus-visible, .cw__send:focus-visible, .cw__chips button:focus-visible,
  .cw__cta:focus-visible, .cw__call:focus-visible { outline: 3px solid var(--aqua-500); outline-offset: 2px; }
  .cw__launcher svg { width: 1.3rem; height: 1.3rem; fill: none; stroke: var(--lime-500); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cw__launcher-short { display: none; }
  @media (max-width: 820px) {
    /* sit above the sticky call / quote bar */
    .cw__launcher { right: .8rem; bottom: calc(5.4rem + env(safe-area-inset-bottom)); padding: .72rem 1rem .72rem .9rem; }
    .cw__launcher-long { display: none; }
    .cw__launcher-short { display: inline; }
  }

  /* ---------- panel ---------- */
  .cw__panel {
    position: fixed; z-index: 120; right: 1.1rem; bottom: 1.1rem;
    width: min(23.5rem, calc(100vw - 2rem)); height: min(36rem, calc(100vh - 2.2rem)); height: min(36rem, calc(100dvh - 2.2rem));
    display: flex; flex-direction: column; overflow: hidden;
    background: #fff; color: var(--ink); font-family: var(--font-body);
    border-radius: 22px; box-shadow: var(--shadow-2), 0 0 0 1px var(--line);
    transform-origin: bottom right; animation: cw-in .28s var(--ease);
  }
  @keyframes cw-in { from { opacity: 0; transform: translateY(14px) scale(.97); } to { opacity: 1; transform: none; } }
  @media (max-width: 640px) {
    .cw__panel { inset: 0; width: auto; height: 100vh; height: 100dvh; border-radius: 0; box-shadow: none; transform-origin: bottom center; }
  }

  .cw__head {
    display: flex; align-items: center; gap: .7rem; padding: .85rem .8rem .85rem 1rem; flex: none;
    background: linear-gradient(120deg, var(--navy-950), var(--navy-800)); color: #fff;
  }
  .cw__avatar { flex: none; width: 2.4rem; height: 2.4rem; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(120deg, var(--lime-500), var(--lime-300)); }
  .cw__avatar svg { width: 1.2rem; height: 1.2rem; fill: none; stroke: var(--navy-950); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .cw__title { flex: 1; min-width: 0; }
  .cw__title h2 { margin: 0; font: 700 1.02rem/1.2 var(--font-display); color: #fff; letter-spacing: 0; }
  .cw__title p { margin: .1rem 0 0; font-size: .76rem; color: rgba(255, 255, 255, .7); }
  .cw__icon-btn {
    flex: none; width: 2.4rem; height: 2.4rem; display: grid; place-items: center; cursor: pointer;
    border: 0; border-radius: 50%; background: rgba(255, 255, 255, .1); color: #fff; transition: background .2s;
  }
  .cw__icon-btn:hover { background: rgba(255, 255, 255, .22); }
  .cw__icon-btn svg { width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* ---------- conversation ---------- */
  .cw__log { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; gap: .6rem; padding: 1rem; background: var(--paper); }
  .cw__msg { max-width: 88%; padding: .65rem .85rem; font-size: .95rem; line-height: 1.5; overflow-wrap: anywhere; }
  .cw__msg p { margin: 0; }
  .cw__msg p + p { margin-top: .5rem; }
  .cw__msg--assistant { align-self: flex-start; background: #fff; border: 1px solid var(--line); border-radius: 16px 16px 16px 4px; }
  .cw__msg--user { align-self: flex-end; background: var(--navy-900); color: #fff; border-radius: 16px 16px 4px 16px; }
  .cw__msg--error { align-self: flex-start; background: #fff4f2; color: #7a2418; border: 1px solid #f1c6bf; border-radius: 16px 16px 16px 4px; }
  .cw__msg a { color: var(--navy-700); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .cw__msg--error a { color: #7a2418; }

  .cw__typing { display: inline-flex; gap: .28rem; align-items: center; padding: .85rem 1rem; }
  .cw__typing span { width: .45rem; height: .45rem; border-radius: 50%; background: var(--muted); opacity: .45; animation: cw-dot 1.1s infinite ease-in-out; }
  .cw__typing span:nth-child(2) { animation-delay: .15s; }
  .cw__typing span:nth-child(3) { animation-delay: .3s; }
  @keyframes cw-dot { 0%, 80%, 100% { transform: translateY(0); opacity: .35; } 40% { transform: translateY(-4px); opacity: 1; } }

  .cw__chips { flex: none; display: flex; flex-wrap: wrap; gap: .4rem; padding: 0 1rem .8rem; background: var(--paper); }
  .cw__chips button {
    cursor: pointer; font: 600 .82rem/1.2 var(--font-body); color: var(--navy-700);
    padding: .5rem .8rem; border-radius: 999px; background: #fff; border: 1px solid rgba(15, 74, 130, .25); transition: background .2s, border-color .2s;
  }
  .cw__chips button:hover { background: var(--aqua-100); border-color: var(--aqua-500); }

  /* ---------- input ---------- */
  .cw__form { flex: none; display: flex; align-items: flex-end; gap: .5rem; padding: .7rem .8rem; background: #fff; border-top: 1px solid var(--line); }
  .cw__form textarea {
    flex: 1; min-width: 0; resize: none; max-height: 7.5rem; overflow-y: hidden; padding: .7rem .85rem;
    font: 400 1rem/1.4 var(--font-body); color: var(--ink); background: #fff;
    border: 1.5px solid rgba(10, 27, 46, .2); border-radius: 14px;
  }
  .cw__form textarea:focus { outline: none; border-color: var(--navy-700); box-shadow: 0 0 0 3px rgba(78, 199, 238, .35); }
  .cw__send {
    flex: none; width: 2.8rem; height: 2.8rem; display: grid; place-items: center; cursor: pointer;
    border: 0; border-radius: 50%; background: var(--navy-900); color: var(--lime-500); transition: transform .2s, opacity .2s, background .2s;
  }
  .cw__send:hover:not(:disabled) { transform: scale(1.06); background: var(--navy-800); }
  .cw__send:disabled { opacity: .45; cursor: not-allowed; }
  .cw__send svg { width: 1.2rem; height: 1.2rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* ---------- footer ---------- */
  .cw__foot { flex: none; padding: .1rem .8rem calc(.75rem + env(safe-area-inset-bottom)); background: #fff; }
  .cw__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .9rem; }
  .cw__cta {
    display: inline-flex; align-items: center; gap: .45rem; padding: .55rem .95rem; border-radius: 999px; text-decoration: none;
    font: 700 .86rem/1 var(--font-body); color: var(--navy-950); background: linear-gradient(100deg, var(--lime-500), var(--lime-300));
  }
  .cw__call { display: inline-flex; align-items: center; gap: .4rem; font: 650 .86rem/1 var(--font-body); color: var(--navy-700); text-decoration: none; padding: .55rem .2rem; }
  .cw__call:hover { text-decoration: underline; }
  .cw__cta svg, .cw__call svg { width: 1em; height: 1em; }
  .cw__foot p { margin: .35rem 0 0; font-size: .72rem; line-height: 1.4; color: var(--muted); }

  @media (prefers-reduced-motion: reduce) {
    .cw__panel { animation: none; }
    .cw__launcher, .cw__launcher:hover { transition: none; transform: none; }
    .cw__typing span { animation: none; opacity: .7; }
  }
  @media print { .cw { display: none; } }
</style>

<script>
  type Role = 'user' | 'assistant';
  interface Msg { role: Role; content: string }

  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const launcher = q<HTMLButtonElement>('[data-chat-open]');
    const panel = q<HTMLElement>('[data-chat-panel]');
    const closeBtn = q<HTMLButtonElement>('[data-chat-close]');
    const resetBtn = q<HTMLButtonElement>('[data-chat-reset]');
    const log = q<HTMLElement>('[data-chat-log]');
    const chips = q<HTMLElement>('[data-chat-chips]');
    const form = q<HTMLFormElement>('[data-chat-form]');
    const input = q<HTMLTextAreaElement>('[data-chat-input]');
    const sendBtn = q<HTMLButtonElement>('[data-chat-send]');

    const endpoint = root.dataset.endpoint || '/api/chat';
    const phone = root.dataset.phone || '';
    const phoneHref = root.dataset.phoneHref || '';

    const STORE_KEY = 'arrowmax-chat-v1';
    const SEND_LAST = 10; // the Worker only uses the last 10 messages
    const KEEP = 20;
    const TIMEOUT_MS = 30000;
    const GREETING =
      'Hi! I’m ArrowMax’s virtual assistant. Ask me about our cleaning services, the areas we serve, or how free estimates work.';

    let history: Msg[] = load();
    let busy = false;

    /* ---- storage (sessionStorage only: it clears when the tab closes; every access is wrapped because it can throw) ---- */
    function load(): Msg[] {
      try {
        const raw = JSON.parse(sessionStorage.getItem(STORE_KEY) || '[]');
        if (!Array.isArray(raw)) return [];
        return raw
          .filter((m): m is Msg => !!m && (m.role === 'user' || m.role === 'assistant') && typeof m.content === 'string')
          .slice(-KEEP);
      } catch {
        return [];
      }
    }
    function save() {
      try {
        sessionStorage.setItem(STORE_KEY, JSON.stringify(history.slice(-KEEP)));
      } catch { /* storage unavailable: chat still works, it just won't survive a page change */ }
    }

    /* ---- rendering: only textContent / createElement, never innerHTML ---- */
    const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const linkRe = new RegExp(
      `(${[
        phone ? esc(phone) : '',
        '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}',
        '/(?:contact|gallery|services|areas|about)(?:/[a-z0-9-]+)*(?![A-Za-z0-9/-])',
      ].filter(Boolean).join('|')})`,
      'g'
    );

    /** Append text to `el`, turning the phone number, email and known site paths into real links. */
    function linkify(text: string, el: HTMLElement) {
      let last = 0;
      for (const m of text.matchAll(linkRe)) {
        const i = m.index ?? 0;
        const s = m[0];
        const isPath = s.startsWith('/');
        if (isPath && i > 0 && /[A-Za-z0-9]/.test(text[i - 1])) continue;
        if (i > last) el.append(text.slice(last, i));
        const a = document.createElement('a');
        a.textContent = s;
        a.href = isPath ? s : s.includes('@') ? `mailto:${s}` : phoneHref;
        el.append(a);
        last = i + s.length;
      }
      if (last < text.length) el.append(text.slice(last));
    }

    /** The model is told not to use markdown, but strip the common bits if it does anyway. */
    const tidy = (t: string) =>
      t.replace(/\*\*(.+?)\*\*/g, '$1').replace(/__(.+?)__/g, '$1').replace(/`+/g, '').replace(/^#+\s*/gm, '').replace(/^\s*[-*]\s+/gm, '• ');

    function bubble(kind: 'user' | 'assistant' | 'error', text: string): HTMLElement {
      const el = document.createElement('div');
      el.className = `cw__msg cw__msg--${kind}`;
      const paragraphs = (kind === 'user' ? text : tidy(text)).split(/\n+/).filter(Boolean);
      for (const para of paragraphs) {
        const p = document.createElement('p');
        if (kind === 'user') p.textContent = para;
        else linkify(para, p);
        el.append(p);
      }
      log.append(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    function typing(): HTMLElement {
      const el = document.createElement('div');
      el.className = 'cw__msg cw__msg--assistant cw__typing';
      el.setAttribute('role', 'status');
      el.setAttribute('aria-label', 'ArrowMax assistant is typing');
      for (let i = 0; i < 3; i++) el.append(document.createElement('span'));
      log.append(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    function renderAll() {
      log.replaceChildren();
      bubble('assistant', GREETING);
      for (const m of history) bubble(m.role, m.content);
      chips.hidden = history.length > 0;
    }

    function autosize() {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
      input.style.overflowY = input.scrollHeight > 120 ? 'auto' : 'hidden'; // scrollbar only once it's actually needed
    }

    function setBusy(on: boolean) {
      busy = on;
      sendBtn.disabled = on;
      input.setAttribute('aria-busy', String(on));
    }

    /* ---- open / close ---- */
    const isPhone = () => window.matchMedia('(max-width: 640px)').matches;
    function open() {
      panel.hidden = false;
      launcher.hidden = true;
      launcher.setAttribute('aria-expanded', 'true');
      if (isPhone()) document.documentElement.style.overflow = 'hidden';
      log.scrollTop = log.scrollHeight;
      window.setTimeout(() => input.focus(), 0);
    }
    function close() {
      panel.hidden = true;
      launcher.hidden = false;
      launcher.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      launcher.focus();
    }

    /* ---- sending ---- */
    async function send(raw: string) {
      const text = raw.trim();
      if (!text || busy) return;
      setBusy(true);
      log.querySelectorAll('.cw__msg--error').forEach((el) => el.remove()); // an old error shouldn't linger once they retry

      history.push({ role: 'user', content: text });
      const userEl = bubble('user', text);
      chips.hidden = true;
      input.value = '';
      autosize();
      const dots = typing();

      const ctrl = new AbortController();
      const timer = window.setTimeout(() => ctrl.abort(), TIMEOUT_MS);
      let failure = '';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history.slice(-SEND_LAST) }),
          signal: ctrl.signal,
        });
        let data: { reply?: unknown; message?: unknown } = {};
        try { data = await res.json(); } catch { /* non-JSON error page */ }
        if (res.ok && typeof data.reply === 'string' && data.reply) {
          history.push({ role: 'assistant', content: data.reply });
          save();
          dots.remove();
          bubble('assistant', data.reply);
        } else {
          failure = typeof data.message === 'string' && data.message ? data.message : 'The assistant is unavailable right now.';
        }
      } catch (err) {
        failure = (err as Error)?.name === 'AbortError'
          ? 'That took too long.'
          : 'I couldn’t reach the assistant. Please check your connection.';
      } finally {
        window.clearTimeout(timer);
      }

      if (failure) {
        // Undo the unsent message so the visitor can edit and retry; always offer the human routes.
        history.pop();
        userEl.remove();
        dots.remove();
        input.value = text;
        autosize();
        const callPart = phone ? ` You can also call ${phone} or` : ' You can';
        bubble('error', `${failure}${callPart} request a free estimate at /contact.`);
      }
      setBusy(false);
      if (!isPhone()) input.focus();
    }

    /* ---- events ---- */
    launcher.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    root.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) close(); });
    form.addEventListener('submit', (e) => { e.preventDefault(); void send(input.value); });
    input.addEventListener('input', autosize);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); void send(input.value); }
    });
    chips.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-chat-suggest]');
      if (b?.dataset.chatSuggest) void send(b.dataset.chatSuggest);
    });
    resetBtn.addEventListener('click', () => {
      history = [];
      try { sessionStorage.removeItem(STORE_KEY); } catch { /* ignore */ }
      renderAll();
      input.focus();
    });

    renderAll();
    launcher.hidden = false; // reveal only once everything above is wired up
  }
</script>
