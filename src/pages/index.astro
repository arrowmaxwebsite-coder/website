---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Swoosh from '../components/Swoosh.astro';
import Ticker from '../components/Ticker.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CountyCard from '../components/CountyCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { SITE, COUNTIES } from '../config';
import { SERVICES, REVIEWS } from '../data/content';

import brownWideBefore from '../assets/photos/ba-brown-wide-before.jpg';
import brownWideAfter from '../assets/photos/ba-brown-wide-after.jpg';

const steps = [
  { t: 'Tell us about your floors', d: 'Send the quick request form or give us a call. Tell us what needs cleaning and where you are.' },
  { t: 'Get a straight answer on price', d: 'A free quote with no pressure and no surprises. You decide if it’s right for you.' },
  { t: 'We show up and get it done', d: 'Careful with your home, honest about the results, and your floors left looking better than when we arrived.' },
];

/* The homepage stays short on purpose: each of these has a full page of its own. */
const explore = [
  { href: '/gallery', icon: 'sparkles', kicker: 'Our work', title: 'See the difference', text: 'Real before & after photos from local jobs.' },
  { href: '/resources', icon: 'eye', kicker: 'Resources', title: 'Know what you’re dealing with', text: 'What builds up in carpet, padding and furniture.' },
  { href: '/about/mission-and-values', icon: 'shield', kicker: 'About us', title: 'Veteran owned & operated', text: 'Our mission, values and roots in the industry.' },
];
---

<Base
  title="ArrowMax Carpet & Floor Cleaning | Westmoreland, Indiana & Cambria PA"
  description="Local carpet, tile & grout, hardwood, upholstery, pet urine and rug cleaning in Westmoreland, Indiana & Cambria County, PA. Free quote, no pressure."
>
  <!-- ============================== HERO ============================== -->
  <section class="hero on-dark">
    <div class="hero__bg" aria-hidden="true"><Swoosh id="hero" /></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <div class="hero__chips">
          <p class="chip"><span class="chip__dot"></span> Trusted local floor cleaning</p>
          <a class="chip chip--vet" href="/about/mission-and-values"><Icon name="shield" /> Veteran owned &amp; operated</a>
        </div>
        <h1>Carpet &amp; Floor Cleaning, <span class="grad-text">Done Right.</span></h1>
        <p class="lead">
          ArrowMax serves Westmoreland, Indiana, and Cambria County, PA with professional carpet, tile, and hardwood floor
          cleaning. Get your free quote today.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary btn--lg" href="/contact">Get your free quote <Icon name="arrow" class="i-arrow" /></a>
          <a class="btn btn--ghost btn--lg" href={SITE.phoneHref}><Icon name="phone" /> {SITE.phone}</a>
        </div>
        <ul class="hero__proof">
          <li>
            <span class="stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>
            <span><strong>5.0</strong> customer rating</span>
          </li>
          <li><Icon name="check" /> No pressure, just a straight answer on price</li>
          <li><Icon name="pin" /> Westmoreland · Indiana · Cambria</li>
        </ul>
      </div>

      <div class="hero__visual">
        <div class="hero__frame">
          <BeforeAfter
            before={brownWideBefore}
            after={brownWideAfter}
            beforeAlt="Brown carpet before cleaning: dark and dingy with deep-set dirt"
            afterAlt="The same brown carpet after professional cleaning: noticeably lighter and fresher"
            caption="Real job · Brown carpet"
            ratio="3 / 2"
            eager
          />
          <span class="float float--rating"><Icon name="star" /> 5.0 rating</span>
          <span class="float float--air"><Icon name="wind" /> <span><strong>Removes allergens</strong><small>Improves air quality</small></span></span>
        </div>
      </div>
    </div>

    <div class="container hero__form"><QuoteForm variant="bar" id="hero-quote" /></div>
  </section>

  <Ticker />

  <!-- ============================== SERVICES ============================== -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div class="section-head__txt">
          <p class="eyebrow">Services</p>
          <h2>What we clean</h2>
          <p>Six services, one local crew, and a straight answer on price for every one of them.</p>
        </div>
        <a class="link-arrow" href="/services">View all services <Icon name="arrow" /></a>
      </div>

      <ul class="svc-grid svc-grid--rows">
        {SERVICES.map((s, i) => <ServiceCard service={s} index={i} delay={(i % 2) * 0.08} compact />)}
      </ul>
    </div>
  </section>

  <!-- ============================== HOW IT WORKS ============================== -->
  <section class="section section--navy why on-dark">
    <div class="why__bg" aria-hidden="true"><Swoosh id="why" animate={false} /></div>
    <div class="container why__grid">
      <div class="why__copy" data-reveal>
        <p class="eyebrow">Why ArrowMax</p>
        <h2>Floor cleaning you can count on in Western PA</h2>
        <p class="lead">
          When your floors need professional attention, you want a company that shows up, does the job right, and leaves
          your home looking better than when they arrived. That’s what ArrowMax is here for.
        </p>
        <a class="vet-callout" href="/about/mission-and-values">
          <span class="vet-callout__icon"><Icon name="shield" /></span>
          <span class="vet-callout__txt">
            <strong>Veteran owned &amp; operated</strong>
            <small>Integrity, discipline, dedication and attention to detail on every job.</small>
          </span>
          <Icon name="arrow" class="vet-callout__go" />
        </a>
        <a class="link-arrow" href="/about">More about ArrowMax <Icon name="arrow" /></a>
      </div>

      <div class="how" data-reveal style="--d:.1s">
        <p class="how__label">How it works</p>
        <ol class="how__list">
          {
            steps.map((s, i) => (
              <li>
                <span class="how__n">{i + 1}</span>
                <div><h3>{s.t}</h3><p>{s.d}</p></div>
              </li>
            ))
          }
        </ol>
        <a class="btn btn--primary" href="/contact">Start with a free quote <Icon name="arrow" class="i-arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ============================== REVIEWS ============================== -->
  <section class="section" id="reviews">
    <div class="container">
      <div class="reviews__head" data-reveal>
        <div class="reviews__title">
          <p class="eyebrow">Reviews</p>
          <h2>Hear from our happy customers</h2>
        </div>
        <div class="reviews__score">
          <span class="reviews__big">5.0</span>
          <div>
            <span class="stars" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>
            <p>5.0 stars · 3 reviews</p>
          </div>
        </div>
      </div>

      <div class="reviews__scroll" tabindex="0" role="region" aria-label="Customer reviews">
        <ul class="reviews__list">
          {REVIEWS.map((r, i) => <ReviewCard review={r} delay={i * 0.1} />)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================== EXPLORE (links to dedicated pages) ============================== -->
  <section class="explore" aria-label="Explore more">
    <div class="container explore__grid">
      {
        explore.map((e, i) => (
          <a class="tile" href={e.href} data-reveal style={`--d:${i * 0.08}s`}>
            <span class="tile__icon"><Icon name={e.icon} /></span>
            <span class="tile__txt">
              <small>{e.kicker}</small>
              <strong>{e.title}</strong>
              <span>{e.text}</span>
            </span>
            <Icon name="arrow" class="tile__go" />
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============================== SERVICE AREA ============================== -->
  <section class="section section--navy area on-dark" id="area">
    <div class="area__bg" aria-hidden="true"><Swoosh id="area" animate={false} /></div>
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div class="section-head__txt">
          <p class="eyebrow">Areas we serve</p>
          <h2>Proudly serving three Western PA counties</h2>
          <p>Westmoreland County, Indiana County and Cambria County. Don’t see your town? Give us a call at <a class="area__tel" href={SITE.phoneHref}>{SITE.phone}</a> and we’ll let you know.</p>
        </div>
        <a class="link-arrow" href="/areas">All service areas <Icon name="arrow" /></a>
      </div>
      <ul class="county-grid">
        {COUNTIES.map((c, i) => <CountyCard county={c} index={i} delay={i * 0.1} />)}
      </ul>
    </div>
  </section>

  <!-- ============================== FAQ ============================== -->
  <section class="section section--paper" id="faq">
    <div class="container faq-wrap">
      <div class="faq-wrap__head" data-reveal>
        <p class="eyebrow">Questions</p>
        <h2>Straight answers</h2>
        <p class="lead">Everything people ask us before they book. Still wondering? Call or send a message.</p>
        <div class="faq-wrap__btns">
          <a class="btn btn--outline" href={SITE.phoneHref}><Icon name="phone" /> {SITE.phone}</a>
          <a class="link-arrow" href="/about/faqs">See all FAQs <Icon name="arrow" /></a>
        </div>
      </div>
      <div data-reveal style="--d:.1s"><FaqList /></div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    position: relative; overflow: hidden; color: #fff; isolation: isolate;
    background:
      radial-gradient(1000px 520px at 88% -8%, rgba(78, 199, 238, .30), transparent 62%),
      radial-gradient(780px 460px at -4% 100%, rgba(168, 223, 24, .17), transparent 60%),
      linear-gradient(180deg, var(--navy-900), var(--navy-950));
    padding-top: clamp(2rem, 3.5vw, 3.5rem);
  }
  .hero__bg { position: absolute; z-index: -1; inset: auto 0 0 0; height: 62%; opacity: .5; pointer-events: none; }
  .hero__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 4vw, 4.5rem); align-items: center; }
  .hero__copy { display: grid; gap: 1.25rem; justify-items: start; }
  .hero__copy h1 { max-width: 13ch; font-size: clamp(2.5rem, 1.1rem + 4.6vw, 4.75rem); }
  .hero__chips { display: flex; flex-wrap: wrap; gap: .6rem; }
  .hero__chips .chip { margin: 0; }
  .chip--vet {
    text-decoration: none; font-weight: 600; color: var(--navy-950); border-color: transparent;
    background: linear-gradient(100deg, var(--lime-500), var(--lime-300));
    box-shadow: 0 8px 22px -8px rgba(168, 223, 24, .7); transition: transform .25s var(--ease), box-shadow .25s;
  }
  .chip--vet :global(svg) { width: 1.15em; height: 1.15em; stroke-width: 2.2; }
  .chip--vet:hover { transform: translateY(-2px); box-shadow: 0 12px 26px -8px rgba(168, 223, 24, .9); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: .4rem; }
  .hero__proof { display: flex; flex-wrap: wrap; gap: .65rem 1.8rem; margin-top: .4rem; color: rgba(255, 255, 255, .82); font-size: .98rem; }
  .hero__proof li { display: flex; align-items: center; gap: .7rem; }
  .hero__proof :global(.icon:not(.i-star)) { color: var(--lime-500); width: 1.15em; height: 1.15em; }
  .hero__proof strong { color: #fff; }

  .hero__visual { display: grid; justify-items: center; padding: .5rem; }
  .hero__frame { position: relative; width: min(100%, 46rem); }
  .hero__frame::before {
    content: ''; position: absolute; inset: -14px -14px 14px 14px; border-radius: 34px; z-index: -1;
    background: linear-gradient(140deg, var(--lime-500), var(--aqua-500)); opacity: .9;
  }
  .hero__frame :global(.ba__cap) { display: none; }
  .hero__frame :global(.ba__frame) { box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .75); }

  .float {
    position: absolute; z-index: 6; display: inline-flex; align-items: center; gap: .6rem;
    background: #fff; color: var(--navy-900); border-radius: 999px; padding: .6rem 1rem .6rem .8rem;
    font-weight: 650; font-size: .92rem; box-shadow: 0 14px 34px -10px rgba(0, 23, 48, .55);
    animation: bob 5s ease-in-out infinite;
  }
  .float :global(svg) { width: 1.2em; height: 1.2em; }
  .float--rating { top: 1.4rem; left: -1.4rem; }
  .float--rating :global(svg) { color: #e5a800; }
  .float--air { right: -1.2rem; top: 38%; border-radius: 18px; animation-delay: -2.4s; }
  .float--air :global(svg) { color: var(--lime-600); width: 1.6em; height: 1.6em; }
  .float--air span { display: grid; line-height: 1.2; }
  .float--air small { font-weight: 500; color: var(--muted); font-size: .78rem; }
  @keyframes bob { 50% { transform: translateY(-7px); } }

  .hero__form { padding-block: clamp(1.75rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3.25rem); }

  @media (max-width: 560px) {
    .hero__copy { justify-items: stretch; }
    .hero__cta { flex-direction: column; }
    .hero__cta .btn { width: 100%; }
    .chip { font-size: .64rem; letter-spacing: .1em; justify-self: start; }
  }
  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__copy h1 { max-width: 14ch; }
    .hero__visual { order: 2; }
    .hero__frame { width: min(100%, 36rem); }
    .float--rating { left: -.4rem; }
    .float--air { right: -.4rem; top: auto; bottom: 4.4rem; }
  }
  /* On phones the photo card is short, so let the allergen badge straddle its bottom edge instead of covering the photo/slider hint */
  @media (max-width: 560px) {
    .float--air { right: .6rem; bottom: -1.1rem; }
    .hero__visual { margin-bottom: .9rem; }
  }

  .section-head__txt { display: grid; gap: 1rem; }

  /* ---------------- why / how ---------------- */
  .why { background: linear-gradient(180deg, var(--navy-950), var(--navy-900)); }
  .why__bg { position: absolute; inset: 0 0 auto 0; height: 55%; opacity: .16; transform: scaleY(-1); pointer-events: none; }
  .why__grid { position: relative; display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .why__copy { display: grid; gap: 1.4rem; justify-items: start; }

  .vet-callout {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.1rem; width: 100%; margin-top: .4rem;
    padding: 1.1rem 1.3rem; border-radius: var(--r-md); text-decoration: none; color: #fff;
    background: linear-gradient(100deg, rgba(168, 223, 24, .16), rgba(78, 199, 238, .1)); border: 1px solid rgba(168, 223, 24, .45);
    transition: transform .3s var(--ease), border-color .3s, background .3s;
  }
  .vet-callout:hover { transform: translateY(-3px); border-color: var(--lime-500); background: linear-gradient(100deg, rgba(168, 223, 24, .24), rgba(78, 199, 238, .14)); }
  .vet-callout__icon { width: 3rem; height: 3rem; border-radius: 14px; display: grid; place-items: center; background: linear-gradient(120deg, var(--lime-500), var(--lime-300)); color: var(--navy-950); }
  .vet-callout__icon :global(svg) { width: 1.45rem; height: 1.45rem; stroke-width: 2.1; }
  .vet-callout__txt { display: grid; line-height: 1.3; }
  .vet-callout__txt strong { font-family: var(--font-display); font-size: 1.2rem; letter-spacing: -0.015em; }
  .vet-callout__txt small { color: rgba(255, 255, 255, .75); font-size: .93rem; margin-top: .15rem; }
  .vet-callout :global(.vet-callout__go) { width: 1.3rem; height: 1.3rem; color: var(--lime-500); transition: transform .3s var(--ease); }
  .vet-callout:hover :global(.vet-callout__go) { transform: translateX(5px); }

  .how {
    display: grid; gap: 1.6rem; padding: clamp(1.6rem, 3vw, 2.5rem); border-radius: var(--r-lg);
    background: rgba(255, 255, 255, .06); border: 1px solid var(--line-dark); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  .how__label { font-family: var(--font-mono); font-size: .74rem; letter-spacing: .16em; text-transform: uppercase; color: var(--aqua-300); }
  .how__list { display: grid; gap: 0; counter-reset: s; position: relative; }
  .how__list li { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1.2rem; padding-bottom: 1.8rem; }
  .how__list li:last-child { padding-bottom: 0; }
  .how__list li:not(:last-child)::before {
    content: ''; position: absolute; left: 1.35rem; top: 2.9rem; bottom: .2rem; width: 3px; border-radius: 3px;
    background: linear-gradient(180deg, var(--lime-500), var(--aqua-500));
  }
  .how__n {
    position: relative; width: 2.8rem; height: 2.8rem; border-radius: 50%; display: grid; place-items: center;
    background: linear-gradient(120deg, var(--lime-500), var(--lime-300)); color: var(--navy-950);
    font-family: var(--font-display); font-weight: 750; font-size: 1.25rem; box-shadow: 0 0 0 6px rgba(168, 223, 24, .16);
  }
  .how__list h3 { font-size: 1.3rem; }
  .how__list p { color: rgba(255, 255, 255, .72); font-size: 1rem; margin-top: .3rem; }
  .how .btn { justify-self: start; }
  @media (max-width: 920px) { .why__grid { grid-template-columns: 1fr; } }

  /* ---------------- reviews (one row of three) ---------------- */
  .reviews__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.5rem 3rem; margin-bottom: clamp(1.8rem, 3.5vw, 2.8rem); }
  .reviews__title { display: grid; gap: 1rem; }
  .reviews__score { display: flex; align-items: center; gap: 1.2rem; }
  .reviews__big { font-family: var(--font-display); font-weight: 780; font-size: clamp(3.4rem, 6vw, 4.8rem); line-height: .9; letter-spacing: -0.05em;
    background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
  .reviews__score .stars { color: #e5a800; font-size: 1.4rem; }
  .reviews__score p { color: var(--muted); font-family: var(--font-mono); font-size: .76rem; letter-spacing: .1em; text-transform: uppercase; margin-top: .3rem; }
  .reviews__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 1.5rem); }
  /* Phones/tablets: a swipeable row instead of a tall stack */
  @media (max-width: 900px) {
    .reviews__scroll { margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none; padding-bottom: .5rem; }
    .reviews__scroll::-webkit-scrollbar { display: none; }
    .reviews__list { display: flex; gap: 1rem; width: max-content; }
    .reviews__list :global(.review) { flex: 0 0 min(82vw, 26rem); scroll-snap-align: start; }
  }

  /* ---------------- explore tiles ---------------- */
  .explore { padding-bottom: clamp(3rem, 5vw, 4.5rem); }
  .explore__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 1.5rem); }
  .tile {
    position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.1rem; padding: 1.4rem 1.5rem;
    text-decoration: none; color: var(--ink); background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg);
    transition: transform .35s var(--ease), box-shadow .35s, border-color .35s, background .35s;
  }
  .tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); border-color: rgba(78, 199, 238, .6); background: #fff; }
  .tile__icon { width: 3.2rem; height: 3.2rem; border-radius: 16px; display: grid; place-items: center; background: var(--navy-900); color: var(--lime-500); }
  .tile__icon :global(svg) { width: 1.5rem; height: 1.5rem; }
  .tile__txt { display: grid; line-height: 1.3; }
  .tile__txt small { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--lime-700); }
  .tile__txt strong { font-family: var(--font-display); font-size: 1.25rem; letter-spacing: -0.02em; margin: .15rem 0 .2rem; }
  .tile__txt span { color: var(--ink-2); font-size: .95rem; }
  .tile :global(.tile__go) { width: 1.4rem; height: 1.4rem; color: var(--navy-700); transition: transform .3s var(--ease); }
  .tile:hover :global(.tile__go) { transform: translateX(5px); }
  @media (max-width: 960px) { .explore__grid { grid-template-columns: 1fr; } }

  /* ---------------- service area ---------------- */
  .area { background: linear-gradient(180deg, var(--navy-900), var(--navy-950)); }
  .area__bg { position: absolute; inset: auto 0 0 0; height: 70%; opacity: .22; pointer-events: none; }
  .area .container { position: relative; }
  .area__tel { color: var(--lime-500); text-underline-offset: 3px; }
  /* Phones: keep the home cards short; each county page lists its towns */
  @media (max-width: 700px) {
    .area :global(.county__towns) { display: none; }
    .area :global(.county) { padding: 1.2rem 1.3rem; gap: .35rem; }
    .area :global(.county__links) { margin-top: .6rem; }
  }

  /* ---------------- faq ---------------- */
  .faq-wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .faq-wrap__head { display: grid; gap: 1.2rem; position: sticky; top: calc(var(--header-h) + 2rem); }
  .faq-wrap__btns { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; }
  @media (max-width: 920px) { .faq-wrap { grid-template-columns: 1fr; } .faq-wrap__head { position: static; } }
</style>
